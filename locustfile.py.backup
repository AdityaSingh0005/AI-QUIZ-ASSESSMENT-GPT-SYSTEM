import re
import uuid
from locust import HttpUser, task, between

QUIZ_ID = 20


class QuizStudent(HttpUser):
    wait_time = between(0.1, 0.3)

    def on_start(self):
        self.finished = False
        unique_id = uuid.uuid4().hex[:12]
        self.student_name = f"Load Test {unique_id}"
        self.roll_number = f"LT{unique_id}"

        # Open guest quiz page.
        with self.client.get(
            f"/guest_start_quiz/{QUIZ_ID}",
            name="1 - Open guest quiz",
            catch_response=True,
        ) as response:
            if response.status_code != 200:
                response.failure(f"Guest page HTTP {response.status_code}")
                self.finished = True
                return
            response.success()

        # Start quiz using a unique test identity.
        with self.client.post(
            f"/guest_start_quiz/{QUIZ_ID}",
            data={
                "student_name": self.student_name,
                "roll_number": self.roll_number,
            },
            name="2 - Start quiz",
            allow_redirects=True,
            catch_response=True,
        ) as response:
            if response.status_code != 200:
                response.failure(f"Quiz start HTTP {response.status_code}")
                self.finished = True
                return

            # Find all question IDs rendered in the quiz page.
            question_ids = re.findall(
                r'data-question-id=["\'](\d+)["\']',
                response.text,
            )

            # Remove duplicates while preserving question order.
            question_ids = list(dict.fromkeys(question_ids))

            if not question_ids or 'id="quizForm"' not in response.text:
                response.failure(
                    "Quiz page loaded, but question IDs/form were not found. "
                    "Check guest-start redirect and HTML."
                )
                self.finished = True
                return

            response.success()

        self.question_ids = question_ids

    @task
    def complete_quiz(self):
        # Each virtual student runs the complete attempt only once.
        if self.finished:
            return

        try:
            for index, question_id in enumerate(self.question_ids):
                last_question = index == len(self.question_ids) - 1

                # The application expects the current question ID,
                # selected option and action in the POST body.
                with self.client.post(
                    "/quiz",
                    data={
                        "question_id": question_id,
                        "current_index": str(index),
                        "selected_option": ["A", "B", "C", "D"][index % 4],
                        "action": "submit" if last_question else "save",
                    },
                    headers={
                        "X-Requested-With": "XMLHttpRequest",
                        "Accept": "application/json",
                    },
                    name="3 - Submit quiz" if last_question
                    else "3 - Save answer and next",
                    catch_response=True,
                ) as response:
                    if response.status_code != 200:
                        response.failure(
                            f"Question {index + 1}: HTTP {response.status_code}"
                        )
                        self.finished = True
                        return

                    try:
                        data = response.json()
                    except ValueError:
                        response.failure(
                            f"Question {index + 1}: response was not JSON"
                        )
                        self.finished = True
                        return

                    if not data.get("ok"):
                        response.failure(
                            f"Question {index + 1}: "
                            f"{data.get('message', 'Unknown application error')}"
                        )
                        self.finished = True
                        return

                    if last_question and not data.get("submitted"):
                        response.failure(
                            "Final request returned success but quiz "
                            "was not marked submitted."
                        )
                        self.finished = True
                        return

                    response.success()

            self.finished = True

        except Exception as exc:
            self.environment.runner.logger.exception(
                "Load-test student failed: %s", exc
            )
            self.finished = True
